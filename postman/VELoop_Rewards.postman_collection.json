{
  "info": {
    "_postman_id": "veloop-rewards-postman-collection-v1",
    "name": "VELoop Rewards API Collection",
    "description": "Complete Postman collection for VELoop Rewards user authentication, profile, rewards, level progression, sponsored ads, token withdrawals, and administration endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "impressionToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alexander Wright\",\n  \"email\": \"alex.wright@veloop.io\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"referralCode\": \"VEL-ALEX99\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('userToken', res.token);",
                  "  if (res.user && res.user.id) {",
                  "    pm.collectionVariables.set('testUserId', res.user.id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"marcus@veloop.io\",\n  \"password\": \"User@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('adminToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@veloop.io\",\n  \"password\": \"Admin@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Profile & Rewards",
      "item": [
        {
          "name": "Get Profile Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/me",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "me"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+1 (555) 382-9102\",\n  \"name\": \"Alexander G. Wright\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile/me",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "me"]
            }
          }
        },
        {
          "name": "Get Reward Balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/rewards",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "rewards"]
            }
          }
        },
        {
          "name": "Get Level Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/level-progress",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "level-progress"]
            }
          }
        },
        {
          "name": "Get Achievements",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/achievements",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "achievements"]
            }
          }
        },
        {
          "name": "Get User Referrals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/referrals",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "referrals"]
            }
          }
        },
        {
          "name": "Get Recent Activity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/activity",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "activity"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Sponsored Ads Engine",
      "item": [
        {
          "name": "Get Ad Availability Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ads/status",
              "host": ["{{baseUrl}}"],
              "path": ["ads", "status"]
            }
          }
        },
        {
          "name": "Start Ad Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.impressionToken) {",
                  "  pm.collectionVariables.set('impressionToken', res.data.impressionToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ads/start-session",
              "host": ["{{baseUrl}}"],
              "path": ["ads", "start-session"]
            }
          }
        },
        {
          "name": "Claim Ad Reward",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"impressionToken\": \"{{impressionToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ads/claim-reward",
              "host": ["{{baseUrl}}"],
              "path": ["ads", "claim-reward"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Withdrawals & Balance Reservations",
      "item": [
        {
          "name": "Create Withdrawal Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25.00,\n  \"asset\": \"tokens\",\n  \"payoutMethod\": \"CRYPTO_USDC\",\n  \"destination\": \"0x71C...B492\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile/withdrawals",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "withdrawals"]
            }
          }
        },
        {
          "name": "Get User Withdrawals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/withdrawals",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "withdrawals"]
            }
          }
        },
        {
          "name": "Get Withdrawal Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/withdrawal-summary",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "withdrawal-summary"]
            }
          }
        }
      ]
    },
    {
      "name": "5. System Administration",
      "item": [
        {
          "name": "Get Dashboard Telemetry",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard", "stats"]
            }
          }
        },
        {
          "name": "Get User Directory",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=10&status=All",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "All" }
              ]
            }
          }
        },
        {
          "name": "Get User Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "{{testUserId}}"]
            }
          }
        },
        {
          "name": "Update User Status (Suspend/Restore)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Suspended\",\n  \"reason\": \"Terms of Service violation #4: Automated script detection\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{testUserId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "{{testUserId}}", "status"]
            }
          }
        },
        {
          "name": "Get Rewards Overview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/rewards",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "rewards"]
            }
          }
        },
        {
          "name": "Adjust User Balance (Audited)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"VEL-894210\",\n  \"asset\": \"ves\",\n  \"amount\": 100,\n  \"reason\": \"Promotional Campaign Bonus #4\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/rewards/adjust",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "rewards", "adjust"]
            }
          }
        },
        {
          "name": "Get Security Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "audit-logs"]
            }
          }
        },
        {
          "name": "Get Platform Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/settings",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "settings"]
            }
          }
        }
      ]
    }
  ]
}
