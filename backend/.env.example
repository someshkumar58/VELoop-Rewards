# ============================================================================
# VELOOP REWARDS — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and configure local development variables.
# NEVER commit production credentials, passwords, or keys to version control.
# ============================================================================

# Network & Server Port
PORT=5000

# MongoDB Database Connection String (Atlas SRV or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/veloop_rewards?retryWrites=true&w=majority

# JWT Signing Secret (minimum 32 random characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Demo Administrator Seed Credentials
ADMIN_SEED_EMAIL=admin@veloop.io
ADMIN_SEED_PASSWORD=your_secure_admin_password

# Client CORS Origins (Development & Production Frontend URLs)
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
